# Template for /opt/personal-crm/.env on the server (permissions 600). Real values never go to git.
# The password goes into a connection URL: use only letters and digits (e.g. `openssl rand -hex 32`).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Sign-in. The secret signs the sign-in cookies: a long random string, run `openssl rand -hex 32`
# on the server. Changing it ends every sign-in.
BETTER_AUTH_SECRET=
# The address of the app: the links in sign-in emails lead here. https://app.testblacklist.ru
BETTER_AUTH_URL=

# Sign-in emails go through Resend. Its SMTP server, the user is "resend", the password is an API
# key with sending access (resend.com → API Keys): smtps://resend:<API key>@smtp.resend.com:465
SMTP_URL=
# The sender; its domain is verified in Resend (resend.com → Domains). noreply@mail.crm.testblacklist.ru
EMAIL_FROM=

# The owner's email: the migrations give this user every contact and group that was there before
# sign-in. Check it letter by letter: whoever signs in with it sees all the data.
OWNER_EMAIL=
