POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB
# Sign-in: the secret of the sign-in cookies, a long random string (openssl rand -hex 32)
BETTER_AUTH_SECRET=
# The address the app is opened at; the links in sign-in emails lead here (http://localhost:3000)
BETTER_AUTH_URL=
# Where emails go: the Mailpit catcher of docker-compose.yml (smtp://127.0.0.1:1025)
SMTP_URL=
# The sender of the emails (noreply@mail.crm.testblacklist.ru)
EMAIL_FROM=
# Your email: the migrations give this user the data that existed before sign-in; pnpm db:seed fills its list
OWNER_EMAIL=